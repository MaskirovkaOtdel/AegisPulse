        {
          "datasource": "Prometheus",
          "expr": "aegispulse_dlq_pending_total",
          "legendFormat": "Pending Retries",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
